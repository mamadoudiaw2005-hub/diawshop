# ─────────────────────────────────────────────────────────────────
# DIAW SHOOP — Exemple de variables d'environnement (.env.example)
# Le site fonctionne en mode "Paiement à la livraison" (Payer à l'arrivée).
# Seules les variables Supabase sont nécessaires pour Vercel.
# ─────────────────────────────────────────────────────────────────

# Configuration Supabase Cloud (Indispensable pour la base de données)
SUPABASE_URL=https://flopepsxpsyrpmhadqkx.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique_supabase

# Configuration du serveur Flask local (optionnel)
FLASK_PORT=8080
FLASK_ENV=production

# Token secret interne
MOCK_SECRET_TOKEN=
